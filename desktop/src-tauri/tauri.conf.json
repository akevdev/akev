{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Akev",
  "version": "0.1.1",
  "identifier": "dev.akev.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Intercept, inspect, mock and debug HTTP(S) traffic",
    "longDescription": "Akev is a fast, lightweight HTTP(S) debugging proxy: intercept browsers, apps, terminals, Android devices and containers; inspect every request; mock, rewrite and breakpoint traffic.",
    "copyright": "\u00a9 Akev contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp",
        "uninstallerHeaderImage": "installer/header.bmp",
        "installerHooks": "installer/hooks.nsh"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "har"
        ],
        "name": "HTTP Archive",
        "description": "HTTP Archive (HAR)",
        "mimeType": "application/json",
        "role": "Viewer"
      },
      {
        "ext": [
          "akev"
        ],
        "name": "Akev session",
        "description": "Akev traffic session",
        "mimeType": "application/x-akev-session",
        "role": "Editor"
      },
      {
        "ext": [
          "saz"
        ],
        "name": "Fiddler session archive",
        "description": "Fiddler session archive",
        "role": "Viewer"
      },
      {
        "ext": [
          "chlsj"
        ],
        "name": "Charles session",
        "description": "Charles JSON session",
        "role": "Viewer"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCMUVBREJEOUUwMTA4OUQKUldTZENBR2V2YTBlNjdobnVsRWZUK0Z4cnBwd3oxU0txbzlXY0cvOXUraUF6eVcvT1o0ZE92OFUK",
      "endpoints": [
        "https://github.com/akevdev/akev/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
