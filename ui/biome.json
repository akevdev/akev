{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["src/**", "scripts/**", "e2e/**", "*.ts", "!dist/**"]
  },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "useSemanticElements": "off",
        "useFocusableInteractive": "warn",
        "noStaticElementInteractions": "warn",
        "useKeyWithClickEvents": "warn",
        "noNoninteractiveTabindex": "warn",
        "useAriaPropsSupportedByRole": "warn",
        "noNoninteractiveElementToInteractiveRole": "warn",
        "noLabelWithoutControl": { "level": "warn", "options": { "inputComponents": ["Input", "TextArea", "NumberInput", "SearchInput", "Checkbox", "Switch"] } },
        "useMediaCaption": "warn",
        "useValidAnchor": "warn",
        "noRedundantAlt": "warn",
        "noAutofocus": "warn"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn",
        "noVoidTypeReturn": "warn",
        "noUnsafeOptionalChaining": "warn",
        "noPrecisionLoss": "warn"
      },
      "suspicious": {
        "noArrayIndexKey": "warn",
        "noControlCharactersInRegex": "off",
        "useIterableCallbackReturn": "warn",
        "noAssignInExpressions": "warn",
        "noImplicitAnyLet": "warn",
        "noNonNullAssertedOptionalChain": "warn",
        "useBiomeIgnoreFolder": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "noDescendingSpecificity": "off"
      },
      "complexity": {
        "noImportantStyles": "off"
      }
    }
  }
}
