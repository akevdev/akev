# Headless Akev daemon: proxy on 8000, API + web UI on 45456.
#
#   docker build -t akev .
#   docker run -v akev-data:/data \
#     -p 127.0.0.1:8000:8000 -p 127.0.0.1:45456:45456 \
#     -e AKEV_TOKEN="$(openssl rand -hex 24)" akev
#
# Inside the container the API and proxy listen on all interfaces so Docker can publish them;
# publish them on 127.0.0.1 (as above) unless other machines should reach them. The API always
# needs the token: a custom one must be at least 24 characters, and without AKEV_TOKEN a
# random one is generated and printed in the log (`docker logs`). The proxy only accepts
# clients from loopback and private networks by default (see the proxy settings).
FROM oven/bun:1 AS ui
WORKDIR /src/ui
COPY ui/package.json ui/bun.lock* ./
RUN bun install --frozen-lockfile
COPY ui/ ./
RUN bun run build

FROM rust:1-bookworm AS build
# BoringSSL (TLS fingerprint impersonation) needs cmake and libclang; the JVM agent a JDK.
RUN apt-get update && apt-get install -y --no-install-recommends cmake clang libclang-dev \
    openjdk-17-jdk-headless && rm -rf /var/lib/apt/lists/*
ENV AKEV_AGENT_REQUIRE_JDK=1
WORKDIR /src
COPY . .
COPY --from=ui /src/ui/dist ui/dist
RUN cargo build --release --locked -p akev-cli --features impersonate

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --home-dir /data --shell /usr/sbin/nologin akev \
    && mkdir -p /data && chown akev:akev /data && chmod 700 /data
COPY --from=build /src/target/release/akev /usr/local/bin/akev
# Licence notices (THIRD-PARTY-NOTICES.md is generated by the release workflow; optional locally).
COPY LICENSE THIRD-PARTY-NOTICES.m[d] /usr/share/doc/akev/
ENV AKEV_DATA_DIR=/data
VOLUME /data
USER akev
EXPOSE 8000 45456
ENTRYPOINT ["akev", "start", "--no-open", "--data-dir", "/data", "--api-bind", "0.0.0.0", "--proxy-bind", "0.0.0.0"]
